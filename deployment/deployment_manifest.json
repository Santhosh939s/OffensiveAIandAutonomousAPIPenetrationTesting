{
  "project_name": "Offensive AI and Autonomous API Penetration Testing",
  "version": "1.0.0",
  "build_type": "standalone_offline_distribution",
  "target_platform": "Windows 10/11 x64 (8 GB RAM)",
  "python_version_minimum": "3.8.10",
  "architecture": {
    "backend_framework": "Flask 3.0+ / Werkzeug 3.0+",
    "inference_engine": "llama-cli (Local CPU GGUF)",
    "database": "SQLite 3 (WAL mode)",
    "policy_enforcement": "ScopeValidator & PolicyEngine (Layer 1 socket hooks)"
  },
  "artifacts": {
    "gguf_model": {
      "path": "models/qwen2.5-1.5b-offensive-ai.Q4_K_M.gguf",
      "format": "GGUF Q4_K_M",
      "size_bytes": 986047872,
      "sha256": "cd7dc83335b02d90f44a7fe4bd0f06eea4d64deb429710f238fe8c5de3da4dc5"
    },
    "lora_adapter": {
      "path": "models/training_artifacts/final_adapter/adapter_model.safetensors",
      "format": "safetensors",
      "size_bytes": 19472304,
      "sha256": "39fd053a1725e15c9f8071578965d9b7d2b58b8aff2d0d722fc36d8796879327"
    }
  },
  "launchers": [
    {
      "file": "launch.bat",
      "type": "Windows Command Script",
      "purpose": "Primary user-facing one-click launcher (pre-flight checks, lab startup, dashboard startup, browser launch)"
    },
    {
      "file": "stop.bat",
      "type": "Windows Command Script",
      "purpose": "Graceful standalone shutdown utility terminating processes on ports 8088 and 5050"
    },
    {
      "file": "launcher.py",
      "type": "Python Orchestrator",
      "purpose": "Underlying system diagnostic and multi-service lifecycle controller"
    }
  ],
  "ports": {
    "dashboard_web_ui": 8088,
    "vulnerable_api_lab": 5050
  },
  "offline_capabilities": {
    "network_disconnected_operation": true,
    "external_cdn_dependencies": false,
    "cloud_ai_api_required": false,
    "localhost_boundary_enforced": true
  }
}
